{% trans_default_domain 'contao_default' %}

{% if type =='start' %}
    <div class="group-widget--element" data-id="{{ id }}" data-mvo--group-widget-target="element">
        <div class="drop-area"
             data-action="dragenter->mvo--group-widget#dragEnter dragover->mvo--group-widget#dragOver:prevent dragleave->mvo--group-widget#dragLeave drop->mvo--group-widget#drop">
        </div>
        <div class="controls">
            <button type="button" disabled="disabled" data-action="mvo--group-widget#up:prevent" data-up>{{ backend_icon('down.svg', 'MSC.move_up.1'|trans) }}</button>
            <div draggable="false"
                 data-action="dragstart->mvo--group-widget#dragStart dragend->mvo--group-widget#dragEnd"
                 data-drag
             >{{ backend_icon('drag.svg', 'MSC.dragItemsHint'|trans) }}</div>
            <button type="button" disabled="disabled" data-action="mvo--group-widget#down:prevent" data-down>{{ backend_icon('down.svg', 'MSC.move_down.1'|trans) }}</button>
            <button type="button" disabled="disabled" data-action="mvo--group-widget#remove:prevent" data-remove>{{ backend_icon('delete.svg', 'MSC.delete'|trans) }}</button>
        </div>
        <div class="widget-group">
{% else %}
        </div>
    </div>
{% endif %}
